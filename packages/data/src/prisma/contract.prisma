// use prisma-8
// Football / soccer data contract for Prisma ORM (SQLite)
enum CompetitionType {
  LEAGUE
  CUP
  INTERNATIONAL
  FRIENDLY
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  EXTRA_TIME
  PENALTIES
  POSTPONED
  CANCELLED
  ABANDONED
}

enum PlayerPosition {
  // Broad categories
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
  // Detailed positions
  SWEEPER
  CENTER_BACK
  FULL_BACK
  DEFENSIVE_MIDFIELD
  CENTRAL_MIDFIELD
  ATTACKING_MIDFIELD
  WINGER
  STRIKER
  SECOND_STRIKER
}

enum GoalType {
  OPEN_PLAY
  PENALTY
  PENALTY_MISS
  OWN_GOAL
  FREE_KICK
  CORNER
  THROW_IN
  VOLLEY
  HEADER
  PENALTY_SHOOTOUT
}

enum EventType {
  YELLOW_CARD
  SECOND_YELLOW
  RED_CARD
  SUBSTITUTION
  VAR_REVIEW
  INJURY
  TIME_WASTING
}

enum LineupStatus {
  STARTER
  BENCH
  NOT_IN_SQUAD
}

enum Foot {
  LEFT
  RIGHT
  BOTH
}

enum AwardCategory {
  PLAYER
  TEAM
  MANAGER
}

model Country {
  id        Int                @id @default(autoincrement()) @map("id")
  name      String             @unique @map("name")
  code      String             @unique @map("code")
  flagUrl   String?            @map("flag_url")
  leagues   League[]
  teams     Team[]
  venues    Venue[]
  players   Player[]
  referees  Referee[]
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@map("country")
}

model Venue {
  id        Int                @id @default(autoincrement()) @map("id")
  name      String             @map("name")
  city      String?            @map("city")
  capacity  Int?               @map("capacity")
  latitude  Float?             @map("latitude")
  longitude Float?             @map("longitude")
  surface   String?            @map("surface")
  country   Country?           @relation(fields: [countryId], references: [id])
  countryId Int?               @map("country_id")
  teams     Team[]
  matches   Match[]
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@unique([name, city])
  @@map("venue")
}

model League {
  id         Int                @id @default(autoincrement()) @map("id")
  name       String             @map("name")
  code       String             @unique @map("code")
  type       CompetitionType    @default(LEAGUE) @map("type")
  logoUrl    String?            @map("logo_url")
  externalId String?            @unique @map("external_id")
  country    Country?           @relation(fields: [countryId], references: [id])
  countryId  Int?               @map("country_id")
  seasons    Season[]
  standings  Standing[]
  createdAt  DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt  temporal.UpdatedAt @map("updated_at")

  @@map("league")
}

model Season {
  id        Int                @id @default(autoincrement()) @map("id")
  year      Int                @map("year")
  name      String             @map("name")
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")
  current   Boolean            @default(false) @map("current")
  league    League             @relation(fields: [leagueId], references: [id])
  leagueId  Int                @map("league_id")
  matches   Match[]
  standings Standing[]
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@unique([leagueId, year])
  @@map("season")
}

model Team {
  id           Int                @id @default(autoincrement()) @map("id")
  name         String             @map("name")
  shortName    String?            @map("short_name")
  code         String?            @map("code")
  foundedYear  Int?               @map("founded_year")
  logoUrl      String?            @map("logo_url")
  primaryColor String?            @map("primary_color")
  externalId   String?            @unique @map("external_id")
  country      Country?           @relation(fields: [countryId], references: [id])
  countryId    Int?               @map("country_id")
  venue        Venue?             @relation(fields: [venueId], references: [id])
  venueId      Int?               @map("venue_id")
  players      Player[]
  homeMatches  Match[]            @relation("HomeTeam")
  awayMatches  Match[]            @relation("AwayTeam")
  lineups      MatchLineup[]
  goals        Goal[]
  matchStats   MatchTeamStat[]
  playerStats  PlayerMatchStat[]
  standings    Standing[]
  transfersIn  Transfer[]         @relation("TransferTo")
  transfersOut Transfer[]         @relation("TransferFrom")
  managers     TeamManager[]
  awardWinners AwardWinner[]
  createdAt    DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt    temporal.UpdatedAt @map("updated_at")

  @@unique([name, countryId])
  @@map("team")
}

model Player {
  id            Int                @id @default(autoincrement()) @map("id")
  name          String             @map("name")
  firstName     String?            @map("first_name")
  lastName      String?            @map("last_name")
  dateOfBirth   DateTime?          @map("date_of_birth")
  nationality   Country?           @relation(fields: [nationalityId], references: [id])
  nationalityId Int?               @map("nationality_id")
  position      PlayerPosition?    @map("position")
  shirtNumber   Int?               @map("shirt_number")
  heightCm      Int?               @map("height_cm")
  weightKg      Int?               @map("weight_kg")
  preferredFoot Foot?              @map("preferred_foot")
  externalId    String?            @unique @map("external_id")
  photoUrl      String?            @map("photo_url")
  currentTeam   Team?              @relation(fields: [currentTeamId], references: [id])
  currentTeamId Int?               @map("current_team_id")
  lineups       MatchLineup[]
  goalsScored   Goal[]             @relation("GoalScorer")
  goalsAssisted Goal[]             @relation("GoalAssist")
  events        MatchEvent[]       @relation("EventPlayer")
  matchStats    PlayerMatchStat[]
  transfersIn   Transfer[]         @relation("PlayerTransfersIn")
  awardWinners  AwardWinner[]
  createdAt     DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt     temporal.UpdatedAt @map("updated_at")

  @@index([currentTeamId])
  @@map("player")
}

model Manager {
  id            Int                @id @default(autoincrement()) @map("id")
  name          String             @map("name")
  dateOfBirth   DateTime?          @map("date_of_birth")
  nationality   Country?           @relation(fields: [nationalityId], references: [id])
  nationalityId Int?               @map("nationality_id")
  photoUrl      String?            @map("photo_url")
  teams         TeamManager[]
  awardWinners  AwardWinner[]
  createdAt     DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt     temporal.UpdatedAt @map("updated_at")

  @@map("manager")
}

model TeamManager {
  id        Int                @id @default(autoincrement()) @map("id")
  team      Team               @relation(fields: [teamId], references: [id])
  teamId    Int                @map("team_id")
  manager   Manager            @relation(fields: [managerId], references: [id])
  managerId Int                @map("manager_id")
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@unique([teamId, managerId, startDate])
  @@map("team_manager")
}

model Referee {
  id        Int                @id @default(autoincrement()) @map("id")
  name      String             @map("name")
  country   Country?           @relation(fields: [countryId], references: [id])
  countryId Int?               @map("country_id")
  photoUrl  String?            @map("photo_url")
  matches   Match[]
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@map("referee")
}

model Match {
  id            Int                @id @default(autoincrement()) @map("id")
  externalId    String?            @unique @map("external_id")
  round         String?            @map("round")
  matchday      Int?               @map("matchday")
  date          DateTime           @map("date")
  status        MatchStatus        @default(SCHEDULED) @map("status")
  elapsedMinute Int?               @map("elapsed_minute")
  venue         Venue?             @relation(fields: [venueId], references: [id])
  venueId       Int?               @map("venue_id")
  referee       Referee?           @relation(fields: [refereeId], references: [id])
  refereeId     Int?               @map("referee_id")
  season        Season             @relation(fields: [seasonId], references: [id])
  seasonId      Int                @map("season_id")
  homeTeam      Team               @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId    Int                @map("home_team_id")
  awayTeam      Team               @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId    Int                @map("away_team_id")
  homeScore     Int?               @map("home_score")
  awayScore     Int?               @map("away_score")
  homeHtScore   Int?               @map("home_ht_score")
  awayHtScore   Int?               @map("away_ht_score")
  homeEtScore   Int?               @map("home_et_score")
  awayEtScore   Int?               @map("away_et_score")
  homePenScore  Int?               @map("home_pen_score")
  awayPenScore  Int?               @map("away_pen_score")
  lineups       MatchLineup[]
  goals         Goal[]
  events        MatchEvent[]
  teamStats     MatchTeamStat[]
  playerStats   PlayerMatchStat[]
  createdAt     DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt     temporal.UpdatedAt @map("updated_at")

  @@index([seasonId])
  @@index([homeTeamId, awayTeamId])
  @@index([date])
  @@map("match")
}

model MatchLineup {
  id            Int                @id @default(autoincrement()) @map("id")
  match         Match              @relation(fields: [matchId], references: [id])
  matchId       Int                @map("match_id")
  team          Team               @relation(fields: [teamId], references: [id])
  teamId        Int                @map("team_id")
  player        Player             @relation(fields: [playerId], references: [id])
  playerId      Int                @map("player_id")
  shirtNumber   Int?               @map("shirt_number")
  position      PlayerPosition?    @map("position")
  formationX    Int?               @map("formation_x")
  formationY    Int?               @map("formation_y")
  status        LineupStatus       @default(NOT_IN_SQUAD) @map("status")
  minutesPlayed Int?               @map("minutes_played")
  rating        Float?             @map("rating")
  captain       Boolean            @default(false) @map("captain")
  createdAt     DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt     temporal.UpdatedAt @map("updated_at")

  @@unique([matchId, playerId])
  @@index([matchId, teamId])
  @@map("match_lineup")
}

model Goal {
  id          Int                @id @default(autoincrement()) @map("id")
  match       Match              @relation(fields: [matchId], references: [id])
  matchId     Int                @map("match_id")
  team        Team               @relation(fields: [teamId], references: [id])
  teamId      Int                @map("team_id")
  scorer      Player?            @relation("GoalScorer", fields: [scorerId], references: [id])
  scorerId    Int?               @map("scorer_id")
  assist      Player?            @relation("GoalAssist", fields: [assistId], references: [id])
  assistId    Int?               @map("assist_id")
  minute      Int                @map("minute")
  addedMinute Int?               @map("added_minute")
  type        GoalType           @default(OPEN_PLAY) @map("type")
  description String?            @map("description")
  createdAt   DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt   temporal.UpdatedAt @map("updated_at")

  @@index([matchId])
  @@index([scorerId])
  @@map("goal")
}

model MatchEvent {
  id              Int                @id @default(autoincrement()) @map("id")
  match           Match              @relation(fields: [matchId], references: [id])
  matchId         Int                @map("match_id")
  team            Team?              @relation(fields: [teamId], references: [id])
  teamId          Int?               @map("team_id")
  player          Player?            @relation("EventPlayer", fields: [playerId], references: [id])
  playerId        Int?               @map("player_id")
  relatedPlayer   Player?            @relation("EventRelatedPlayer", fields: [relatedPlayerId], references: [id])
  relatedPlayerId Int?               @map("related_player_id")
  type            EventType          @map("type")
  minute          Int                @map("minute")
  addedMinute     Int?               @map("added_minute")
  detail          String?            @map("detail")
  createdAt       DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt       temporal.UpdatedAt @map("updated_at")

  @@index([matchId])
  @@index([playerId])
  @@map("match_event")
}

model MatchTeamStat {
  id             Int                @id @default(autoincrement()) @map("id")
  match          Match              @relation(fields: [matchId], references: [id])
  matchId        Int                @map("match_id")
  team           Team               @relation(fields: [teamId], references: [id])
  teamId         Int                @map("team_id")
  possession     Float?             @map("possession")
  shots          Int?               @map("shots")
  shotsOnTarget  Int?               @map("shots_on_target")
  shotsOffTarget Int?               @map("shots_off_target")
  shotsBlocked   Int?               @map("shots_blocked")
  corners        Int?               @map("corners")
  fouls          Int?               @map("fouls")
  offsides       Int?               @map("offsides")
  yellowCards    Int?               @map("yellow_cards")
  redCards       Int?               @map("red_cards")
  passes         Int?               @map("passes")
  passAccuracy   Float?             @map("pass_accuracy")
  expectedGoals  Float?             @map("expected_goals")
  createdAt      DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt      temporal.UpdatedAt @map("updated_at")

  @@unique([matchId, teamId])
  @@map("match_team_stat")
}

model PlayerMatchStat {
  id             Int                @id @default(autoincrement()) @map("id")
  match          Match              @relation(fields: [matchId], references: [id])
  matchId        Int                @map("match_id")
  player         Player             @relation(fields: [playerId], references: [id])
  playerId       Int                @map("player_id")
  team           Team               @relation(fields: [teamId], references: [id])
  teamId         Int                @map("team_id")
  minutesPlayed  Int?               @map("minutes_played")
  rating         Float?             @map("rating")
  goals          Int?               @map("goals")
  assists        Int?               @map("assists")
  shots          Int?               @map("shots")
  shotsOnTarget  Int?               @map("shots_on_target")
  passes         Int?               @map("passes")
  passAccuracy   Float?             @map("pass_accuracy")
  keyPasses      Int?               @map("key_passes")
  tackles        Int?               @map("tackles")
  interceptions  Int?               @map("interceptions")
  duelsWon       Int?               @map("duels_won")
  duelsLost      Int?               @map("duels_lost")
  foulsCommitted Int?               @map("fouls_committed")
  foulsDrawn     Int?               @map("fouls_drawn")
  yellowCards    Int?               @map("yellow_cards")
  redCards       Int?               @map("red_cards")
  saves          Int?               @map("saves")
  goalsConceded  Int?               @map("goals_conceded")
  createdAt      DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt      temporal.UpdatedAt @map("updated_at")

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("player_match_stat")
}

model Standing {
  id           Int                @id @default(autoincrement()) @map("id")
  season       Season             @relation(fields: [seasonId], references: [id])
  seasonId     Int                @map("season_id")
  league       League             @relation(fields: [leagueId], references: [id])
  leagueId     Int                @map("league_id")
  team         Team               @relation(fields: [teamId], references: [id])
  teamId       Int                @map("team_id")
  position     Int?               @map("position")
  played       Int                @default(0) @map("played")
  won          Int                @default(0) @map("won")
  drawn        Int                @default(0) @map("drawn")
  lost         Int                @default(0) @map("lost")
  goalsFor     Int                @default(0) @map("goals_for")
  goalsAgainst Int                @default(0) @map("goals_against")
  goalDiff     Int                @default(0) @map("goal_diff")
  points       Int                @default(0) @map("points")
  form         String?            @map("form")
  createdAt    DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt    temporal.UpdatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@map("standing")
}

model Transfer {
  id         Int                @id @default(autoincrement()) @map("id")
  player     Player             @relation("PlayerTransfersIn", fields: [playerId], references: [id])
  playerId   Int                @map("player_id")
  fromTeam   Team?              @relation("TransferFrom", fields: [fromTeamId], references: [id])
  fromTeamId Int?               @map("from_team_id")
  toTeam     Team               @relation("TransferTo", fields: [toTeamId], references: [id])
  toTeamId   Int                @map("to_team_id")
  date       DateTime           @map("date")
  fee        Float?             @map("fee")
  currency   String?            @map("currency")
  type       String?            @map("type")
  createdAt  DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt  temporal.UpdatedAt @map("updated_at")

  @@index([playerId])
  @@index([toTeamId])
  @@map("transfer")
}

model Injury {
  id        Int                @id @default(autoincrement()) @map("id")
  player    Player             @relation(fields: [playerId], references: [id])
  playerId  Int                @map("player_id")
  team      Team?              @relation(fields: [teamId], references: [id])
  teamId    Int?               @map("team_id")
  type      String?            @map("type")
  reason    String?            @map("reason")
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")
  status    String             @default("ACTIVE") @map("status")
  createdAt DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  @@index([playerId])
  @@map("injury")
}

model Award {
  id          Int            @id @default(autoincrement()) @map("id")
  name        String         @unique @map("name")
  category    AwardCategory  @map("category")
  description String?        @map("description")
  externalId  String?        @unique @map("external_id")
  winners     AwardWinner[]
  createdAt   DateTime       @default(now()) @onCreate(now()) @map("created_at")
  updatedAt   temporal.UpdatedAt @map("updated_at")

  @@map("award")
}

model AwardWinner {
  id         Int                @id @default(autoincrement()) @map("id")
  award      Award              @relation(fields: [awardId], references: [id])
  awardId    Int                @map("award_id")
  year       Int                @map("year")
  season     String?            @map("season")
  place      Int                @default(1) @map("place")
  points     Float?             @map("points")
  player     Player?            @relation(fields: [playerId], references: [id])
  playerId   Int?               @map("player_id")
  team       Team?              @relation(fields: [teamId], references: [id])
  teamId     Int?               @map("team_id")
  manager    Manager?           @relation(fields: [managerId], references: [id])
  managerId  Int?               @map("manager_id")
  externalId String?            @unique @map("external_id")
  createdAt  DateTime           @default(now()) @onCreate(now()) @map("created_at")
  updatedAt  temporal.UpdatedAt @map("updated_at")

  @@index([awardId, year])
  @@index([playerId])
  @@index([teamId])
  @@map("award_winner")
}
