\n\n[[package]]\nname = \"windows_aarch64_gnullvm\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"32a4622180e7a0ec044bb555404c800bc9fd9ec262ec147edd5989ccd0c02cd3\"\n\n[[package]]\nname = \"windows_aarch64_msvc\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"09ec2a7bb152e2252b53fa7803150007879548bc709c039df7627cabbd05d469\"\n\n[[package]]\nname = \"windows_i686_gnu\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"8e9b5ad5ab802e97eb8e295ac6720e509ee4c243f69d781394014ebfe8bbfa0b\"\n\n[[package]]\nname = \"windows_i686_gnullvm\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"0eee52d38c090b3caa76c563b86c3a4bd71ef1a819287c19d586d7334ae8ed66\"\n\n[[package]]\nname = \"windows_i686_msvc\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"240948bc05c5e7c6dabba28bf89d89ffce3e303022809e73deaefe4f6ec56c66\"\n\n[[package]]\nname = \"windows_x86_64_gnu\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"147a5c80aabfbf0c7d901cb5895d1de30ef2907eb21fbbab29ca94c5b08b1a78\"\n\n[[package]]\nname = \"windows_x86_64_gnullvm\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"24d5b23dc417412679681396f2b49f3de8c1473deb516bd34410872eff51ed0d\"\n\n[[package]]\nname = \"windows_x86_64_msvc\"\nversion = \"0.52.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"589f6da84c646204747d1270a2a5661ea66ed1cced2631d546fdfb155959f9ec\"\n\n[[package]]\nname = \"wio\"\nversion = \"0.2.2\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"5d129932f4644ac2396cb456385cbf9e63b5b30c6e8dc4820bdca4eb082037a5\"\ndependencies = [\n \"winapi\",\n]\n\n[[package]]\nname = \"xxhash-rust\"\nversion = \"0.8.21\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"40de123dbb523ebcc00d61ec01840ad192578afc378d859f3429caa38308fad5\"\n\n[[package]]\nname = \"yeslogic-fontconfig-sys\"\nversion = \"6.0.1\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"1d8b8abf912b9a29ff112e1671c97c33636903d13a69712037190e6805af4f76\"\ndependencies = [\n \"dlib\",\n \"once_cell\",\n \"pkg-config\",\n]\n\n[[package]]\nname = \"zerocopy\"\nversion = \"0.8.65\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"32bc8a75f879cd6fe53a6bedf3c28f0e1b914c77424fc2be9e2ec85d7d25aff5\"\ndependencies = [\n \"zerocopy-derive\",\n]\n\n[[package]]\nname = \"zerocopy-derive\"\nversion = \"0.8.65\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"b8bfd2644ea1681f60cf95029ff18aa8ad1cc3f7b8fe37286f8e473bb29f816b\"\ndependencies = [\n \"proc-macro2\",\n \"quote\",\n \"syn 2.0.119\",\n]\n\n[[package]]\nname = \"zlib-rs\"\nversion = \"0.6.9\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"aa76918995d776d9dd34d371030be228d021137449771493d56e29f77e4148ac\"\n\n[[package]]\nname = \"zstd\"\nversion = \"0.13.6\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"b04655dc7bf4abd8ebe23dac6bef20fceea52a29ad19e37a4101b3951d7e8b45\"\ndependencies = [\n \"zstd-safe\",\n]\n\n[[package]]\nname = \"zstd-safe\"\nversion = \"7.4.2\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"df2575690b2a3eccad509fe7898cdde32a5afca06a06449ff4dcfb318c7b7281\"\ndependencies = [\n \"zstd-sys\",\n]\n\n[[package]]\nname = \"zstd-sys\"\nversion = \"2.2.0+zstd.1.6.0\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"c3f4089cda6dda4dc43c43dd9f8964140064fd2f752f3da46c3a483c3c175160\"\ndependencies = [\n \"cc\",\n \"pkg-config\",\n]\n"
  },
  "cells": [
    {
      "id": "f05f03c7-56f7-4edc-95f3-09c882607196",
      "cell_type": "markdown",
      "source": "## Abstract\n\nHow often do teams overturn big deficits — and does it happen more than the legends suggest? This study answers it using the full match archive drawn from the Soccers football database. The choke is rarer than the legend suggests — and almost never happens from a truly big lead. All computation runs in Rust inside a `.mars` notebook (polars + plotters — charts as inline SVG), and every table and figure is generated from the extracted CSVs.\n\n## Keywords\n\n**Keywords:** football, analysis, comebacks, mars, sqlite\n\n## Table of contents\n\n- [Abstract](#abstract)\n- [Keywords](#keywords)\n- [Introduction](#introduction)\n- [Methods](#methods)\n- [Results](#results)\n  - [Replay timelines: who trailed, who recovered?](#replay-timelines-who-trailed-who-recovered)\n- [Discussion](#discussion)\n- [Conclusion](#conclusion)\n\n## Introduction\n\nEvery fan lives for the comeback — trailing at half-time, even 2–0 down,\nthen winning. This notebook replays every goal-by-goal timeline in the\nStatsBomb subset (~4,200 matches with timing data) and asks: **which teams\nare historically best at erasing deficits?**\n\nA *comeback win* = a team trailed by at least one goal at some point and\nstill won. We rank teams by comeback-win rate (comebacks ÷ matches where\nthey trailed), with a minimum-sample guard, and break comebacks down by\nthe size of the deficit erased.\n\n**Coverage caveat:** goal timing exists only for StatsBomb matches\n(World Cups, Euros, Champions League, top domestic leagues) — a smaller\nbut high-quality subset.\n",
      "metadata": {},
      "outputs": []
    },
    {
      "id": "c297a35b-a66d-4931-ace0-32a6dcf062a5",
      "cell_type": "markdown",
      "source": "## Methods\n\nData were extracted from the Soccers football database (`packages/data`) as CSV snapshots: `goal_events`.\n\nThe analysis runs entirely in Rust inside the notebook: **polars** handles table scans, joins and aggregations; **plotters** renders figures as inline SVG; `mars_table` renders result tables.\n\nEach code cell is kept to a single output so results can be read top to bottom.\n",
      "metadata": {},
      "outputs": []
    },
    {
      "id": "27cf07c6-bda4-4d22-982c-effce7fe7c68",
      "cell_type": "markdown",
      "source": "## Results\n\nAll figures and tables below are computed directly from the extracted data. Each code cell produces one output — a table, a chart, or a short text summary.\n",
      "metadata": {},
      "outputs": []
    },
    {
      "id": "efc0dfbd-1f93-468f-b5ba-fff1f173c4d6",
      "cell_type": "code",
      "source": "use polars::prelude::*;\n\nlet df = LazyCsvReader::new(\"data/goal_events.csv\")\n    .finish()\n    .expect(\"failed to open data/goal_events.csv — run from the notebook directory\")\n    .collect()\n    .expect(\"failed to collect CSV into DataFrame\");\n\nprintln!(\n    \"loaded {} goal rows | schema: {:?}\",\n    df.height(),\n    df.get_column_names()\n);",
      "metadata": {},
      "execution_count": 1,
      "outputs": [
        {
          "type": "text",
          "text": "loaded 11328 goal rows | schema: [\"mid\", \"minute\", \"added_minute\", \"player\", \"gtid\", \"gteam\", \"hid\", \"aid\", \"home\", \"away\", \"hg\", \"ag\", \"league\", \"date\", \"season\"]\n"
        }
      ]
    },
    {
      "id": "5fec7d5e-d195-43ce-af33-5f438351bbae",
      "cell_type": "code",
      "source": "\nlet s = |name: &str| df.column(name).unwrap_or_else(|_| panic!(\"missing {name}\")).clone();\nlet col_str = |name: &str| -> Vec<String> {\n    s(name).str().unwrap().iter().map(|o| o.unwrap_or(\"\").to_string()).collect()\n};\nlet col_i64 = |name: &str| -> Vec<i64> {\n    let c = s(name);\n    let c = if c.dtype() == &DataType::Null { c.cast(&DataType::Int64).unwrap() } else { c };\n    c.i64().unwrap().iter().map(|o| o.unwrap_or(0)).collect()\n};\nlet mid_v = col_i64(\"mid\");\nlet league_v = col_str(\"league\");\nlet hid_v = col_i64(\"hid\");\nlet aid_v = col_i64(\"aid\");\nlet home_v = col_str(\"home\");\nlet away_v = col_str(\"away\");\nlet hg_v = col_i64(\"hg\");\nlet ag_v = col_i64(\"ag\");\nlet minute_v = col_i64(\"minute\");\nlet added_v = col_i64(\"added_minute\");\nlet gtid_v = col_i64(\"gtid\");\nlet gteam_v = col_str(\"gteam\");\nlet ng = df.height();\nprintln!(\"extracted {ng} goal rows\");\n// index goals by match, sorted by (minute, added)\nuse std::collections::BTreeMap;\nlet mut order: Vec<usize> = (0..ng).collect();\norder.sort_by_key(|&i| (mid_v[i], minute_v[i], added_v[i]));\n\n// per-match goal lists\nlet mut match_goals: BTreeMap<i64, Vec<usize>> = BTreeMap::new();\nfor &i in &order {\n    match_goals.entry(mid_v[i]).or_default().push(i);\n}\n\n// team display names\nlet mut names: std::collections::HashMap<i64, String> = std::collections::HashMap::new();\nfor i in 0..ng {\n    names.entry(hid_v[i]).or_insert_with(|| home_v[i].clone());\n    names.entry(aid_v[i]).or_insert_with(|| away_v[i].clone());\n}\nprintln!(\"matches with goal data: {}\", match_goals.len());",
      "metadata": {},
      "execution_count": 2,
      "outputs": [
        {
          "type": "text",
          "text": "loaded 11328 goal rows | schema: [\"mid\", \"minute\", \"added_minute\", \"player\", \"gtid\", \"gteam\", \"hid\", \"aid\", \"home\", \"away\", \"hg\", \"ag\", \"league\", \"date\", \"season\"]\nextracted 11328 goal rows\nmatches with goal data: 3703\n"
        }
      ]
    },
    {
      "id": "5e08f221-2842-4a37-8665-722fd9a4b83d",
      "cell_type": "markdown",
      "source": "### Replay timelines: who trailed, who recovered?\n\nFor each team-match we track the worst deficit suffered (min of\nmy_goals − opp_goals after every goal) and the final result.\n",
      "metadata": {},
      "outputs": []
    },
    {
      "id": "14c76117-dc3e-4aa0-958a-c2bb12f1f7f1",
      "cell_type": "code",
      "source": "use std::collections::HashMap;\n\n#[derive(Default, Clone)]\nstruct Acc {\n    played: u64,      // matches with goal data the team appears in\n    trailed: u64,     // matches where they were behind at some point\n    comebacks: u64,   // trailed AND won\n    cb1: u64, cb2: u64, cb3: u64, // comebacks by max deficit erased\n}\n\nlet mut acc: HashMap<i64, Acc> = HashMap::new();\nlet mut big_comebacks: Vec<(i64, String, String, String)> = Vec::new(); // deficit, desc, team, mid\n\nfor (_mid, idxs) in match_goals.iter() {\n    let i0 = idxs[0];\n    let (hid, aid) = (hid_v[i0], aid_v[i0]);\n    let (hg, ag) = (hg_v[i0], ag_v[i0]);\n    let mut hs = 0i64;\n    let mut as_ = 0i64;\n    // per side: worst deficit (most negative my-opp) and final my goals\n    let mut h_min = 0i64;\n    let mut a_min = 0i64;\n\n    for &gi in idxs {\n        if gtid_v[gi] == hid { hs += 1; } else { as_ += 1; }\n        let d = hs - as_;\n        if -d > h_min { h_min = -d; }\n        if d > a_min { a_min = d; }\n    }\n    // h_min/a_min now hold the largest deficit each side suffered\n    let h_won = hg > ag;\n    let a_won = ag > hg;\n\n    {\n        let e = acc.entry(hid).or_default();\n        e.played += 1;\n        if h_min > 0 {\n            e.trailed += 1;\n            if h_won {\n                e.comebacks += 1;\n                if h_min == 1 { e.cb1 += 1; } else if h_min == 2 { e.cb2 += 1; } else { e.cb3 += 1; }\n                if h_min >= 3 && big_comebacks.len() < 10 {\n                    big_comebacks.push((h_min, format!(\"{} {}–{} {} ({})\", home_v[i0], hg, ag, away_v[i0], league_v[i0]), home_v[i0].clone(), mid_v[i0].to_string()));\n                }\n            }\n        }\n    }\n    {\n        let e = acc.entry(aid).or_default();\n        e.played += 1;\n        if a_min > 0 {\n            e.trailed += 1;\n            if a_won {\n                e.comebacks += 1;\n                if a_min == 1 { e.cb1 += 1; } else if a_min == 2 { e.cb2 += 1; } else { e.cb3 += 1; }\n                if a_min >= 3 && big_comebacks.len() < 10 {\n                    big_comebacks.push((a_min, format!(\"{} {}–{} {} ({})\", away_v[i0], ag, hg, home_v[i0], league_v[i0]), away_v[i0].clone(), mid_v[i0].to_string()));\n                }\n            }\n        }\n    }\n}\n\n// overall comeback profile\nlet (mut p, mut t, mut c, mut c1, mut c2, mut c3) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);\nfor a in acc.values() {\n    p += a.played; t += a.trailed; c += a.comebacks; c1 += a.cb1; c2 += a.cb2; c3 += a.cb3;\n}\nprintln!(\"team-matches in dataset: {p} | trailed at some point: {t} ({:.1}%)\", t as f64 / p as f64 * 100.0);\nprintln!(\"comeback wins: {c} — {:.1}% of matches trailed ended in victory\", c as f64 / t as f64 * 100.0);\nprintln!(\"by deficit erased: 1 goal {c1} | 2 goals {c2} | 3+ goals {c3}\");\n\n// deficit distribution table\nlet dist_rows = vec![\n    vec![\"1 goal\".to_string(), c1.to_string()],\n    vec![\"2 goals\".to_string(), c2.to_string()],\n    vec![\"3+ goals\".to_string(), c3.to_string()],\n];\nmars_table(&[\"deficit erased\", \"comeback wins\"], &dist_rows);\n",
      "metadata": {},
      "execution_count": 3,
      "outputs": [
        {
          "type": "text",
          "text": "loaded 11328 goal rows | schema: [\"mid\", \"minute\", \"added_minute\", \"player\", \"gtid\", \"gteam\", \"hid\", \"aid\", \"home\", \"away\", \"hg\", \"ag\", \"league\", \"date\", \"season\"]\nextracted 11328 goal rows\nmatches with goal data: 3703\nteam-matches in dataset: 7406 | trailed at some point: 4219 (57.0%)\ncomeback wins: 443 — 10.5% of matches trailed ended in victory\nby deficit erased: 1 goal 414 | 2 goals 29 | 3+ goals 0\n"
        },
        {
          "type": "table",
          "columns": [
            "deficit erased",
            "comeback wins"
          ],
          "rows": [
            [
              "1 goal",
              "414"
            ],
            [
              "2 goals",
              "29"
            ],
            [
              "3+ goals",
              "0"
            ]
          ]
        }
      ]
    },
    {
      "id": "3ece5366-bbb4-4b63-bb4d-a027d61f75cb",
      "cell_type": "code",
      "source": "// team rankings: rate = comebacks / trailed, min 15 trailed matches\nlet mut ranked: Vec<(&i64, &Acc)> = acc.iter().filter(|(_, a)| a.trailed >= 15).collect();\nranked.sort_by(|a, b| {\n    let ra = a.1.comebacks as f64 / a.1.trailed as f64;\n    let rb = b.1.comebacks as f64 / b.1.trailed as f64;\n    rb.partial_cmp(&ra).unwrap()\n});\nlet rate_rows: Vec<Vec<String>> = ranked\n    .iter()\n    .take(15)\n    .map(|(tid, a)| {\n        vec![\n            names.get(*tid).cloned().unwrap_or_else(|| tid.to_string()),\n            a.trailed.to_string(),\n            a.comebacks.to_string(),\n            format!(\"{:.1}%\", a.comebacks as f64 / a.trailed as f64 * 100.0),\n        ]\n    })\n    .collect();\nmars_table(&[\"team\", \"times trailed\", \"comebacks\", \"comeback rate\"], &rate_rows);\n",
      "metadata": {},
      "execution_count": 4,
      "outputs": [
